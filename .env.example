FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-long-random-value
REQUIRE_STRONG_SECRET=1
APP_HOST=0.0.0.0
APP_PORT=5000
CAST_IP=replace-with-cast-lan-ip
CAST_TIMEOUT_SECONDS=10
COMMAND_RATE_LIMIT_SECONDS=0.75
DATABASE_PATH=/volume1/path-to-app/instance/app.sqlite3
SETTINGS_PATH=/volume1/path-to-app/instance/config.json
PRESETS_PATH=/volume1/path-to-app/instance/presets.json
MEDIA_DIRECTORY=/volume1/path-to-app/media
LOG_DIRECTORY=/volume1/path-to-app/logs
AUDIT_LOG_PATH=/volume1/path-to-app/logs/audit.log
LOG_LEVEL=INFO
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
