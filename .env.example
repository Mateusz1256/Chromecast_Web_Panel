FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=replace-with-a-long-random-value
APP_HOST=0.0.0.0
APP_PORT=5000
CAST_IP=192.168.0.39
CAST_TIMEOUT_SECONDS=10
COMMAND_RATE_LIMIT_SECONDS=0.75
DATABASE_PATH=/volume1/skrypty/cast-panel/instance/app.sqlite3
SETTINGS_PATH=/volume1/skrypty/cast-panel/instance/config.json
MEDIA_DIRECTORY=/volume1/skrypty/cast-panel/media
LOG_DIRECTORY=/volume1/skrypty/cast-panel/logs
LOG_LEVEL=INFO
